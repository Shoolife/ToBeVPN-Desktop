{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "ToBeVPN",
        "width": 445,
        "height": 698,
        "minWidth": 311,
        "maxWidth": 578,
        "minHeight": 489,
        "maxHeight": 908,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ]
  },
  "bundle": {
    "resources": [
      "bin/geoip.dat",
      "bin/geosite.dat",
      "bin/wintun.dll"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer.nsh"
      }
    }
  }
}
