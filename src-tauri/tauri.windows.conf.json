{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "ToBeVPN",
        "width": 494,
        "height": 855,
        "minWidth": 494,
        "maxWidth": 494,
        "minHeight": 855,
        "maxHeight": 855,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ]
  },
  "bundle": {
    "resources": {
      "bin/geoip.dat": "bin/geoip.dat",
      "bin/geosite.dat": "bin/geosite.dat",
      "bin/wintun.dll": "wintun.dll"
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer.nsh"
      }
    }
  }
}
