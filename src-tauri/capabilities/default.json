{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "tg://*" },
        { "url": "https://t.me/*" }
      ]
    },
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://__BOT_API_HOST__/*" },
        { "url": "https://__PANEL_HOST__/*" },
        { "url": "https://__FALLBACK_HOST__/*" }
      ]
    },
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
