{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToBeVPN",
  "version": "1.0.80",
  "identifier": "com.tobevpn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ToBeVPN",
        "width": 494,
        "height": 895,
        "minWidth": 380,
        "maxWidth": 494,
        "minHeight": 600,
        "maxHeight": 895,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#0d0d0d"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' tauri: ipc:",
        "img-src": "'self' data: blob: tauri: asset: ipc:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://__BOT_API_HOST__ https://__PANEL_HOST__ https://speed.cloudflare.com https://api.github.com",
        "font-src": "'self' data: tauri: ipc:"
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/xray",
      "bin/tun2socks"
    ],
    "resources": [
      "bin/geoip.dat",
      "bin/geosite.dat"
    ],
    "linux": {
      "deb": {
        "depends": [
          "iproute2",
          "procps",
          "util-linux",
          "pkexec | policykit-1"
        ],
        "files": {
          "/usr/local/bin/tobevpn-helper.sh": "../scripts/tobevpn-helper.sh",
          "/usr/local/bin/tobevpn-update-helper.sh": "../scripts/tobevpn-update-helper.sh",
          "/usr/share/polkit-1/actions/app.tobevpn.network.policy": "../scripts/app.tobevpn.network.policy",
          "/usr/share/polkit-1/actions/app.tobevpn.update.policy": "../scripts/app.tobevpn.update.policy"
        },
        "postInstallScript": "../scripts/postinst.sh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Shoolife/ToBeVPN-Desktop/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDQTkyQzdDOUVGMzk5NEMKUldSTW1mT2VmQ3lwM01NWkFhQ2ZoZ21kVjdCWFNUbk5kU0E4UHRvUVhKRGhPZjR5QVRWYW00azMK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["tobevpn"]
      }
    }
  }
}
