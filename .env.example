VITE_BOT_API_URL=https://your-backend.example/
VITE_PANEL_URL=https://your-panel.example/

# Fallback endpoints (fallback endpoints). When the primary host is
# unreachable (network error, timeout, ISP-level block), the app
# transparently retries the same request against the fallback.
#
#   VITE_FALLBACK_BOT_DOMAIN  — fallback endpoint URL (no trailing
#       `?u=`). The original request's path-with-query is URL-encoded and
#       appended as `?u=<path>` so the function can forward to upstream.
#       Example: https://<fallback-host>/<bot-fn-id>
#       Result:  https://<fallback-host>/<id>?u=%2Fapi%2Ftest
#
#   VITE_FALLBACK_SUBS_DOMAIN — full URL with `?sub=` already at the end.
#       The short_uuid (trailing path segment of the original
#       https://<panel-host>/<KEY>) is appended directly.
#       Example: https://<fallback-host>/<subs-fn-id>?sub=
VITE_FALLBACK_BOT_DOMAIN=https://<fallback-host>/your-bot-fn-id
VITE_FALLBACK_SUBS_DOMAIN=https://<fallback-host>/your-subs-fn-id?sub=
